# Server
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp_ai

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=your-meta-permanent-access-token
META_PHONE_NUMBER_ID=123456789012345
# App secret used to validate the X-Hub-Signature-256 header (leave empty to disable the check)
META_APP_SECRET=your-meta-app-secret
WEBHOOK_VERIFY_TOKEN=my-verify-token

# LLM
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Set to true to skip real Meta/OpenAI calls (used by the mock webhook runner)
MOCK_MODE=false
